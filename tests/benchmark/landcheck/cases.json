              "project_name": {
                "contains": "嘉顺苑"
              }
            },
            "values": {
              "rooms": 5989,
              "surveys": 35,
              "area": {
                "approx": 669441.53
              }
            }
          },
          {
            "rank": 2,
            "match": {
              "project_name": {
                "contains": "佳兆业"
              }
            },
            "values": {
              "rooms": 5284,
              "surveys": 110
            }
          },
          {
            "rank": 3,
            "match": {
              "project_name": {
                "contains": "金茂乾璟苑"
              }
            },
            "values": {
              "rooms": 4208,
              "surveys": 28
            }
          }
        ]
