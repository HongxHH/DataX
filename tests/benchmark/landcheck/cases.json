    {
      "id": "lc_usage_category_stats",
      "query": "按用途统计房间数，给出用途代码和中文标签",
      "tags": [
        "usage",
        "ref_enum",
        "seed",
        "core"
      ],
      "expected_tables": [
        "room_info",
        "ref_enum"
      ],
      "gold_sql": "SELECT r.usage_category, e.enum_label, COUNT(*) AS rooms FROM room_info r LEFT JOIN ref_enum e ON e.enum_group = 'usage_category' AND e.enum_code = r.usage_category WHERE r.is_deleted = 0 GROUP BY r.usage_category, e.enum_label ORDER BY rooms DESC",
      "required_sql_patterns": [
        "(?i)usage_category",
        "(?i)ref_enum",
        "(?i)enum_group\\s*=\\s*'usage_category'"
      ],
      "forbidden_sql_patterns": [
        "(?i)\\broom_usage\\b"
      ],
      "expect": {
        "kind": "keyed_rows",
        "rows": [
          {
            "match": {
              "usage_category": "RESIDENTIAL"
            },
            "values": {
              "rooms": 38822
            }
          },
          {
            "match": {
              "usage_category": "COMMERCIAL"
            },
            "values": {
              "rooms": 14798
            }
          }
        ]
      },
      "require_schema_linking": true,
      "notes": "中文标签题：schema_linking 必须含 ref_enum（require_schema_linking 硬闸）；缺表时内核 LABEL-001 拒答。"
    },
