{
  "version": 2,
  "name": "landcheck_nl2sql_l1",
  "description": "Landcheck NL2SQL L1 黄金集：执行一致率为主，表命中与 sql_rules_landcheck 规则为辅。",
  "dialect": "mysql",
  "database": "landcheck",
  "data_snapshot": {
    "project_alive": 59,
    "room_alive": 69945,
    "survey_alive": 1258,
    "contract_alive": 57,
    "deleted_rows_observed": 0,
    "notes": [
      "当前库软删行数为 0：缺少 is_deleted=0 时执行结果仍可能碰巧正确，故软删依赖 SQL 必含规则（defaults.required_sql_patterns 会与用例合并）。",
      "expect 数字按本快照固化；库变更后先跑 --validate-gold 再改 expect。"
    ]
  },
  "defaults": {
    "numeric_abs_tol": 1.0,
    "required_sql_patterns": [
      "(?i)is_deleted`?\\s*=\\s*0"
    ],
    "forbidden_sql_patterns": [
      "(?i)\\bstrftime\\b",
      "(?i)\\b(insert|update|delete|drop|alter|truncate)\\s+",
      "(?i)\\bv_[a-z0-9_]+\\b",
      "(?i)sys_user\\.password",
      "(?i)contract_info\\.total_area"
    ]
  },
  "metric_coverage": {
    "execution_consistency": "primary — cases with expect.*",
    "table_recall_sql": "auxiliary — expected_tables ⊆ tables in pred SQL",
    "table_recall_schema_linking": "soft report in runner; hard-gate only if require_schema_linking",
    "sql_rule_patterns": "auxiliary — YEAR / usage_category / no join-explosion / etc.",
    "security_intercept": "minimal — lc_security_no_password only",
    "routing": "not in L1 (Copilot L2)",
    "latency": "runner records e2e_ms + summary percentiles when agent mode"
  },
  "cases": [
    {
      "id": "lc_zhigu_rooms_area",
      "query": "智谷项目有多少房间、建筑面积多少",
      "tags": [
        "project_filter",
        "aggregate",
        "seed",
        "core"
      ],
      "expected_tables": [
        "project",
        "room_info"
      ],
      "gold_sql": "SELECT p.project_name, COUNT(*) AS rooms, ROUND(SUM(r.building_area), 2) AS area FROM room_info r JOIN project p ON p.id = r.project_id WHERE r.is_deleted = 0 AND p.is_deleted = 0 AND p.project_name LIKE '%智谷%' GROUP BY p.project_name",
      "required_sql_patterns": [
        "(?i)LIKE",
        "(?i)building_area"
      ],
      "expect": {
        "kind": "scalar_multi",
        "values": {
          "rooms": 535,
          "area": {
            "approx": 395113.23
          }
        }
      },
      "notes": "允许只返回聚合列（无 project_name）；列名可用 room_count / total_building_area 等别名。"
    },
    {
      "id": "lc_zhigu_inner_area",
      "query": "智谷项目的套内面积合计多少",
      "tags": [
        "project_filter",
        "area_field",
        "core"
      ],
      "expected_tables": [
        "project",
        "room_info"
      ],
      "gold_sql": "SELECT ROUND(SUM(r.inner_area), 2) AS inner_area FROM room_info r JOIN project p ON p.id = r.project_id WHERE r.is_deleted = 0 AND p.is_deleted = 0 AND p.project_name LIKE '%智谷%'",
      "required_sql_patterns": [
        "(?i)inner_area"
      ],
      "expect": {
        "kind": "scalar",
        "column": "inner_area",
        "approx": 322425.88
      },
      "notes": "区分套内 vs 建筑面积；若误用 building_area 会得到约 395113，与 322425.88 不一致而失败。"
    },
    {
      "id": "lc_top_projects_by_rooms",
      "query": "房间数最多的 10 个项目",
