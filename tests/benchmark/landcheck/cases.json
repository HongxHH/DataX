        "ranking",
        "seed",
        "core"
      ],
      "expected_tables": [
        "project",
        "room_info"
      ],
      "gold_sql": "SELECT p.project_name, (SELECT COUNT(*) FROM room_info r WHERE r.project_id = p.id AND r.is_deleted = 0) AS rooms FROM project p WHERE p.is_deleted = 0 ORDER BY rooms DESC LIMIT 10",
      "expect": {
        "kind": "ordered_top",
        "limit": 3,
        "rows": [
          {
            "rank": 1,
            "match": {
              "project_name": {
                "contains": "嘉顺苑"
              }
            },
            "values": {
              "rooms": 5989
            }
          },
          {
            "rank": 2,
            "match": {
              "project_name": {
                "contains": "佳兆业"
              }
            },
            "values": {
              "rooms": 5284
            }
          },
          {
            "rank": 3,
            "match": {
              "project_name": {
                "contains": "金茂乾璟苑"
              }
            },
            "values": {
              "rooms": 4208
            }
          }
        ]
      }
    },
